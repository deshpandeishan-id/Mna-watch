# Copy to .env for running on your own machine / server. Never commit .env.

# Required by the SEC: your name and email
SEC_USER_AGENT="Jane Smith jane@example.com"

# AI classification (pick one; Gemini has a free tier). Leave both empty for keyword-only mode.
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.5-flash
ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-haiku-5-5

# Email. For Gmail: turn on 2-Step Verification, then create an App Password.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=you@gmail.com
SMTP_PASSWORD=your-16-char-app-password
EMAIL_TO=you@gmail.com

# Optional
# SOURCES=sec,uk_panel,euronext,eqs,globenewswire,prnewswire,bse
# ALERT_STAGES=rumour,possible_offer,definitive_agreement,tender_offer,revised_offer,competing_offer
# POLL_SECONDS=90
# EXTRA_RSS_FEEDS=mynews|EU|https://example.com/feed.rss
# DRY_RUN=true
